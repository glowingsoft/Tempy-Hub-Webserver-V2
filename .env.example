PORT=6060
PORT_SOCKET=6061
HOST=0.0.0.0
# Quick Cloudflare tunnel on start in non-prod (npm package downloads the binary).
CLOUDFLARE_TUNNEL=true
# BASE_URL=mongodb+srv://username:password@cluster.mongodb.net/database
BASE_URL=mongodb://localhost:27017/tempy-hub-local
JWT_SECRET=dummy_jwt_secret
NODE_ENV=example
ADMIN_ACCESS_TOKEN=dummy_ADMIN_ACCESS_TOKEN
#testing acc dummyemail@example.com
SENDGRID_API_KEY=SG.dummy_sendgrid_api_key
SENDGRID_SENDER_EMAIL=your_verified_sender_email@example.com
AWS_EMAIL_SECRET_ID=dummy_aws_email_secret_id
AWS_EMAIL_SECRET_KEY=dummy_aws_email_secret_key
AWS_EMAIL_REGION=us-east-1
AWS_SENDER_EMAIL=no-reply@example.com
AWS_PINPOINT_APP_ID=dummy_aws_pinpoint_app_id
AWS_PINPOINT_SENDER_ID=dummy_aws_pinpoint_sender_id
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=dummy_aws_s3_access_key_id
AWS_S3_SECRET_ACCESS_KEY=dummy_aws_s3_secret_access_key
S3_BUCKET_NAME=dummy_s3_bucket_name
S3_BASE_URL=https://dummybucket.s3.us-east-1.amazonaws.com/
SUPPORT_EMAIL=support@tempyhub.com


#increment this to trigger bootstrap again
BOOTSTRAP_VERSION=6
#BOOTSTRAP STARTUP USERS
#Tempy platform operator: userType "admin", sits above every organization
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@tempyhub.com
BOOTSTRAP_SUPERADMIN_PASSWORD=superTempy11

#Demo org owner: userType "user" + Membership{role:"owner"} on the org below
BOOTSTRAP_OWNER_EMAIL=owner@tempyhub.com
BOOTSTRAP_OWNER_PASSWORD=ownerTempy11
BOOTSTRAP_ORG_NAME=Demo Care Group

# Cron (node-cron). Heartbeat logs every minute so you can confirm it runs.
# Faster test: CRON_HEARTBEAT_SCHEDULE=*/5 * * * * *
CRON_ENABLED=true
CRON_HEARTBEAT=true
CRON_HEARTBEAT_SCHEDULE=* * * * *
CRON_AUTO_CHECKOUT=true
CRON_AUTO_CHECKOUT_SCHEDULE=*/30 * * * *
