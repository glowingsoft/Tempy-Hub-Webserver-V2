{
  "name": "tempy-hub-backend",
  "version": "1.0.0",
  "description": "saas sytem for care homes",
  "main": "backend/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev nodemon backend/server.js",
    "prod": "cross-env NODE_ENV=prod node backend/server.js",
    "mobileapps": "cross-env NODE_ENV=mobileapps node backend/server.js",
    "pm2:dev:start": "pm2 start backend/config/ecosystem.config.js --env dev",
    "pm2:dev:reload": "pm2 reload tempy-hub-backend --update-env",
    "pm2:dev:stop": "pm2 stop tempy-hub-backend",
    "pm2:dev:delete": "pm2 delete tempy-hub-backend",
    "pm2:prod:start": "pm2 start backend/config/ecosystem.config.js --env prod",
    "pm2:prod:reload": "pm2 reload tempy-hub-backend --update-env",
    "pm2:prod:stop": "pm2 stop tempy-hub-backend",
    "pm2:prod:delete": "pm2 delete tempy-hub-backend",
    "pm2:logs": "pm2 logs tempy-hub-backend",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "update:alias": "node aliasConfig/update-aliases.js",
    "swagger:serve-hint": "echo Open Swagger UI at http://localhost:6060/api/v1/docs",
    "swagger:validate": "node -e \"JSON.parse(require('fs').readFileSync('swagger/swagger_output.json','utf8')); console.log('swagger_output.json OK')\"",
    "postman:normalize": "node postman_collection/scripts/normalize-collection.js",
    "postman:build": "npm run postman:normalize && npm run postman:validate",
    "postman:validate": "node postman_collection/scripts/validate-postman.js"
  },
  "keywords": [],
  "author": "Zawar Ahmad",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-pinpoint": "^3.650.0",
    "@aws-sdk/client-s3": "^3.651.1",
    "@aws-sdk/client-ses": "^3.650.0",
    "@aws-sdk/lib-storage": "^3.651.1",
    "@aws-sdk/s3-request-presigner": "^3.651.1",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@sendgrid/mail": "^8.1.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vonage/server-sdk": "^3.19.2",
    "aws-sdk": "^1.18.0",
    "bad-words": "^4.0.0",
    "bcryptjs": "^2.4.3",
    "cloudflared": "^0.7.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "i18n": "^0.15.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mime": "^4.0.4",
    "mime-types": "^2.1.35",
    "module-alias": "^2.3.4",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.7",
    "p-limit": "^6.2.0",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.3",
    "shortid": "^2.2.16",
    "sib-api-v3-sdk": "^8.5.0",
    "socket.io": "^4.8.0",
    "stripe": "^17.5.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "socket.io-client": "^4.8.0"
  },
  "_moduleAliases": {
    "@utils": "backend/helperUtils",
    "@models": "backend/models",
    "@config": "backend/config",
    "@controllersCommonModules": "backend/commonModules/controllers",
    "@adminServices": "backend/admin/services",
    "@appServices": "backend/app/services",
    "@commonServices": "backend/commonModules/services",
    "@services": "backend/services",
    "@assets": "backend/assets",
    "@middlewares": "backend/middlewares",
    "@notificationsUtil": "backend/commonModules/services/communication/communicationService.js",
    "@redisCache": "backend/config/redis/redisCache.js",
    "@socketIo": "backend/config/sockets"
  }
}
